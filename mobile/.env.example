# Where the app talks to. Defaults to production when unset.
# iOS simulator can use localhost; the Android emulator is rewritten to 10.0.2.2 automatically.
# On a real phone use your computer's LAN address, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=https://remio.in

# Google sign-in. The web client id is the same one the website uses (GOOGLE_CLIENT_ID on the server).
# The iOS client id is a separate "iOS" OAuth client in Google Cloud. Both are public values.
# It only works in an installed build, not in Expo Go; the button is hidden when it cannot work.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
