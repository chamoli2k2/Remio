{
  "expo": {
    "name": "Remio",
    "slug": "remio",
    "scheme": "remio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5f3fa",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.remio.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.remio.app",
      "adaptiveIcon": {
        "backgroundColor": "#5a45e0",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#f5f3fa",
          "dark": {
            "backgroundColor": "#1f1d28"
          }
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Remio uses your photos so you can add pictures to flashcards.",
          "cameraPermission": "Remio uses the camera so you can photograph something for a flashcard."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5a45e0",
          "defaultChannel": "reminders"
        }
      ],
      "./plugins/withKotlinPackageFix.js",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "StudyWidget",
              "displayName": "Study today",
              "description": "Cards due, today's goal and your streak.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "src/widgets/StudyWidget.ios.js"
              },
              "android": {
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "initialLayout": "src/widgets/StudyWidget.android.js"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3e14e5e5-0a0c-45c7-8434-0d99d538ada5"
      }
    },
    "owner": "chamoli2k2"
  }
}
