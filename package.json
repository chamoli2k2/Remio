{
  "name": "remio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "dev:server": "node --watch server/src/index.js",
    "dev:local": "node scripts/local.js",
    "build": "NODE_ENV=production VITE_DEMO_MODE=false vite build && NODE_ENV=production VITE_DEMO_MODE=false vite build --ssr",
    "start": "node server/src/index.js",
    "test": "LOG_LEVEL=silent node --test --test-concurrency=1 server/test/*.test.js",
    "seed": "node server/src/seed.js",
    "healthcheck": "node scripts/healthcheck.js",
    "test:integration": "RUN_INTEGRATION=1 LOG_LEVEL=silent node --test --test-concurrency=1 server/test/integration.test.js server/test/realtime.integration.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:preview": "VITE_DEMO_MODE=true vite build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.4.15",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fflate": "^0.8.3",
    "helmet": "^8.1.0",
    "jsdom": "^29.1.1",
    "katex": "^0.18.7",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.13",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "sql.js": "^1.14.2",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.0.3",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4",
    "vite": "^7.1.6"
  }
}
